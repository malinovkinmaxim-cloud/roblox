		MinAlive = 74,
		Mix = { Goober = 2, Skitter = 2.2, Husk = 2.4, Charger = 1.7, Splitter = 1.1, Spitter = 0.9, Bomber = 1.1, Blinker = 1.1, Brute = 0.7, Diver = 1, Leaper = 0.8, Summoner = 0.3, Ghost = 0.8, Mimic = 0.1 },
