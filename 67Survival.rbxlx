	-- BOSS 2 (6:00)
	{ At = 350, Rate = 4, MinAlive = 60, Mix = { Goober = 2, Skitter = 2, Husk = 2.4, Charger = 1.3, Spitter = 0.8, Bomber = 0.9, Blinker = 1, Ghost = 0.7 }, Pack = { Skitter = 5 } },
	{
