		},
		Unlock = { Default = true },
	},
	{
		Key = "Rocket",
		Name = "Rocket",
		Desc = "Homing rockets with a big explosion.",
		Kind = "Missile",
		Category = "PROJECTILE",
		Rarity = "Uncommon",
		Color = rgb(90, 200, 255),
		MaxLevel = 7,
		Base = { Damage = 22, Cooldown = 1.8, Amount = 1, Radius = 5, Speed = 42, Duration = 3, Range = 70, Knockback = 6 },
		Levels = {
			[2] = { Amount = 1, Desc = "+1 rocket" },
			[3] = { Damage = 9, Desc = "+9 damage" },
			[4] = { Radius = 1.5, Desc = "Bigger explosions" },
			[5] = { BurnHit = 8, Desc = "Explosions leave enemies burning", New = true },
			[6] = { Amount = 1, Cooldown = -0.3, Desc = "+1 rocket, fires faster" },
			[7] = { Damage = 12, SplitEnd = 3, Desc = "Cluster rockets: 3 bomblets after each blast", New = true },
		},
		Unlock = { Default = true },
	},
	{
		Key = "Boomerang",
		Name = "Boomerang",
		Desc = "Flies out, comes back. Pierces everything.",
		Kind = "Boomerang",
		Category = "PROJECTILE",
		Rarity = "Common",
