		Mix = { Goober = 2.5, Skitter = 2, Husk = 2.4, Charger = 1.5, Splitter = 1, Spitter = 0.8, Bomber = 0.9, Blinker = 1, Brute = 0.4, Diver = 0.8 },
		Pack = { Skitter = 5 },
