		Unlock = { Default = true },
		Evolution = { From = "Laser", With = "Duration" },
	},
} :: any)

local WeaponData = {}
WeaponData.List = LIST
WeaponData.ByKey = {} :: { [string]: WeaponDef }
WeaponData.ById = {} :: { [number]: WeaponDef }
WeaponData.Evolutions = {} :: { WeaponDef } -- every evolved form
WeaponData.EvolutionOf = {} :: { [string]: WeaponDef } -- base ability key -> its evolution

WeaponData.Categories = { "PROJECTILE", "AREA", "MELEE", "SUMMON", "DEFENSIVE", "SPECIAL" }

for id, def in LIST do
	def.Id = id
	WeaponData.ByKey[def.Key] = def
	WeaponData.ById[id] = def
	if def.Evolution then
		table.insert(WeaponData.Evolutions, def)
		WeaponData.EvolutionOf[def.Evolution.From] = def
	end
end

function WeaponData.Get(key: string): WeaponDef
	local def = WeaponData.ByKey[key]
	assert(def, "unknown weapon " .. tostring(key))
	return def
end

-- an ability the player can get in level-up offers (not an evolution)
function WeaponData.IsBase(key: string): boolean
	local def = WeaponData.ByKey[key]
	return def ~= nil and def.Evolution == nil
end

-- Raw stats of a weapon at a level (before the player's stats)
function WeaponData.RawStats(key: string, level: number): { [string]: number }
	local def = WeaponData.Get(key)
	local out = table.clone(def.Base)
	for l = 2, math.clamp(level, 1, def.MaxLevel) do
		local delta = def.Levels[l]
		if delta then
			for stat, value in delta do
				if type(value) == "number" then
					out[stat] = (out[stat] or 0) + value
				end
			end
		end
	end
	return out
end

return WeaponData
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
