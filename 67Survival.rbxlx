	},
	{ At = 300, Rate = 4.8, MinAlive = 66, Mix = { Goober = 2, Skitter = 2.2, Husk = 2.4, Charger = 1.6, Splitter = 1.1, Spitter = 0.9, Bomber = 1, Blinker = 1.1, Brute = 0.6, Diver = 1, Leaper = 0.6, Summoner = 0.25 }, Pack = { Skitter = 6 } },
	{
